  m_text: "<b>PROJETO</b>\r\n\r\nDesenvolvido por\r\nAlunos e Professores do Senac
    Palho\xE7a\r\n\r\n\r\n<b>COORDENA\xC7\xC3O</b>\r\n\r\nCl\xE1udio Roberto Martins\r\nDanielle
    Martins Castro\r\nRenata Beatriz Scheidt\r\n\r\n\r\n<b>PROFESSORES ORIENTADORES</b>\r\n\r\nAlexandre
    Thiesen\r\nPrograma\xE7\xE3o Front-End e Back-End\r\n\r\nBruno Martins de Abreu\r\nUser
    Experience\r\nTestes\r\nPrograma\xE7\xE3o Front-End\r\nAnima\xE7\xE3o\r\n\r\nDaniel
    Pinho Campos\r\nArte 2D\r\nArte 3D\r\n\r\nCl\xE1udio Roberto Martins\r\nGame
    Design\r\nGest\xE3o T\xE9cnica do Projeto\r\n\r\n\r\n<b>EQUIPE DE DESENVOLVIMENTO</b>\r\n\r\nARTE
    2D\r\n\r\nBernardo Rocha\r\nCaetano Ferre Madeira\r\nHeloisa Oliveira Konkel\r\n\r\nARTE
    3D\r\n\r\nArthur Lostada Martins\r\nCau\xE3 Leandro Coelho\r\nEnzo Felipe Schlagel\r\n\r\n\r\nMOTION
    DESIGN E ANIMA\xC7\xC3O\r\n\r\nGabriel Langa Gutjahr\r\nMatheus Ventura Soares\r\n\r\nPRODU\xC7\xC3O
    DE \xC1UDIO\r\n\r\nAndriel Alessi Viegas\r\nFrancisco Scheidt\r\nGabriel Neckel
    de Borba\r\nLuis Gustavo Naiate Jahn\r\nPhelipe Tamagno\r\n\r\nGAME DESIGN\r\n\r\nArthur
    Veras Bonelli\r\nErick Lichtenfels Pudell\r\n\r\nPROGRAMA\xC7\xC3O BACK-END\r\n\r\nAntonio
    Francisco dos Santos\r\nGustavo Serafim Manzoni\r\nJosue Ramos Figueiredo Petri\r\n\r\nPROGRAMA\xC7\xC3O
    FRONT-END\r\n\r\nPedro Gabriel Vicente\r\n\r\nUSER EXPERIENCE E TESTES\r\n\r\nGuilherme
    Dominoni Gon\xE7alves\r\nJulie Gabrielle Maia dos Santos\r\nSofia Silveira de
    Souza\r\nVictor da Silva Ferreira\r\n"
  m_isRightToLeft: 0
